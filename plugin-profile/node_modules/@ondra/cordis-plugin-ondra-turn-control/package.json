{
  "name": "@ondra/cordis-plugin-ondra-turn-control",
  "version": "1.0.0",
  "private": true,
  "description": "空谷 Ondra 的轮次控制：注册 /cancel-turn 内核命令，命令处理器直接调用当前 agent 的 cancel() 中断本轮——弥补 stdio SDK 协议在 dsh 0.2.2-rc.1 上没有 session/cancel 方法的缺口。连接与进程保持，队列保留（keepInbox 语义交给 agent 默认清空：stop 语义就是「这轮不要了」）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*",
    "@deepseek-ai/dsh-commands": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}