{
  "name": "@ondra/dsh-sidecar",
  "version": "1.1.7-alpha",
  "private": true,
  "description": "dsh 内核：独立 Node 子进程，只负责推理循环、工具调用、会话存储与模型适配，不加载任何界面代码。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-sidecar": "lib/index.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "dev": "node --experimental-strip-types src/index.ts",
    "start": "node lib/index.js"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
