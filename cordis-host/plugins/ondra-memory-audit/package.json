{
  "name": "@ondra/cordis-plugin-ondra-memory-audit",
  "version": "2.1.2",
  "private": true,
  "description": "空谷 Ondra 的遗忘审计：回答「她为什么记不清了」——强度、半衰期、剩余时间与三档话术；钉住（≤8）与四态删除（forget 写墓碑 / seal 封存 / 自然沉底 / revise 订正留旧文）。只调记忆内核的公开方法，不写 memory_fact 任何一列。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
