{
  "name": "@ondra/cordis-plugin-ondra-adapter-feishu",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的飞书通道：宿主路由接事件订阅、verificationToken 校验、加密体明确拒绝、单条 4000 切条、先回 {\"code\":0} 再异步发消息。它不自己 listen 端口——路由挂在宿主 webServer 上，卸载即撤。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
