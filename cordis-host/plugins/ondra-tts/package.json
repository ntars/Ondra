{
  "name": "@ondra/cordis-plugin-ondra-tts",
  "version": "2.1.2",
  "private": true,
  "description": "空谷 Ondra 的语音合成（手册 §1.7 / §1.8 复用档）：三条通道并存——本地 GPT-SoVITS（api_v2）、macOS say（零依赖）、Edge TTS（19 音色 + 8 套预设）。只做接线、选路与降级，不重写任何合成机制：文字进、音频出、落 cache/tts 内容寻址缓存，失败一律返回原因码而不是抛错。要不要出声归 O-051 的四道闸门，本插件不做判定、不注册工具。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
