{
  "name": "@ondra/cordis-plugin-ondra-adapter-qq-official",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的 QQ 官方机器人通道：分条 1200、被动回复必带原 msg_id、六道防封闸、一通道一份凭据与一份状态。传输是端口不是实现——没有协议依据就不写「看起来能跑」的握手。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
