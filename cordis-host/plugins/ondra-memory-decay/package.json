{
  "name": "@ondra/cordis-plugin-ondra-memory-decay",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的记忆衰减：强度一律问 O-010（不重算第二份公式），SM-2 与艾宾浩斯八档融合排复习，清晰度三档话术，孤儿复习计划清理；只衰减条目，边归 O-015。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
