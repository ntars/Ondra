{
  "name": "@ondra/cordis-plugin-ondra-memory-recognition",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的 recognition 检索分支：全索引（每条记忆一行识别触发词）进 prompt + 小模型挑 slug + [[links]] 邻域游走；500 条约 6k token，索引块按 seq 升序固定，可做前缀缓存。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
