{
  "name": "@ondra/cordis-plugin-ondra-grow",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的养成系统（L9 扩展池）：把相处天数、互动次数、活跃记忆条数、关系阶序四项既有读数归一化加权成一条里程分，落进五档（萌芽/抽枝/成荫/开花/结果），并给一句不含任何数字的「下一步」提示。只读派生、不建第二套数值、不报分数、不改关系、不画界面。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
