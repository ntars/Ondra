{
  "name": "@ondra/cordis-plugin-ondra-memory-dedupe",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的记忆判重：写入前的五分类裁决（add/merge/append/conflict/drop），只用「字符二元组包含度 0.4」一个口径；合并走 revise 不走 forget，决策日志可解释。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
