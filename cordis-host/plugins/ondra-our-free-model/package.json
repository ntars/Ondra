{
  "name": "@ondra/cordis-plugin-ondra-our-free-model",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的免费模型渠道层：两条免密车道（默认关闭、零出站）+ 76 家聚合渠道注册表，产出可直接写入 pi-ai 的 provider profile。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
