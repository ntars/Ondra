{
  "name": "@ondra/cordis-plugin-ondra-rhythm-typing",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的打字执行层（手册 §9.2 / 第 1363 行）：把 ondra-rhythm 的分条计划跑成真实时间线——首条「在想」、两条之间「正在输入」、长停顿期间不装打字、可按会话取消、同会话新一轮顶掉旧一轮、卸载即停。缺节奏服务时退回一次性整段发出（不模拟打字）。只执行不发内容：分条归 ondra-rhythm，正在输入与呼吸感归 ondra-breath。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
