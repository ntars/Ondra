{
  "name": "@ondra/cordis-plugin-ondra-adapter-telegram",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的 Telegram 通道：getUpdates 长轮询（timeout 50）、token 只在 URL 里且全程脱敏、offset 做结构性去重、失败 3 秒退避、单条 4000 切条。它是拉取式——不注册任何路由、不占端口，循环挂在 ctx.effect 的 disposer 上，卸载即停。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
