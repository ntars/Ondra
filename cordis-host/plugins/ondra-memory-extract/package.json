{
  "name": "@ondra/cordis-plugin-ondra-memory-extract",
  "version": "2.1.2",
  "private": true,
  "description": "空谷 Ondra 的记忆提炼：调用模型从对话里提炼事实，带四类来源引文与逐字校验、数字必须有出处、五级解析兜底；不判重、不算寿命。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
