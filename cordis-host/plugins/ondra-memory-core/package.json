{
  "name": "@ondra/cordis-plugin-ondra-memory-core",
  "version": "2.1.2",
  "private": true,
  "description": "空谷 Ondra 的记忆内核：双层表（原文 memory_raw / 提炼 memory_fact）、11 类基线寿命乘积式、写入打分、四态删除与墓碑、归档沉底与最低曝光候选。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
