{
  "name": "@ondra/cordis-plugin-ondra-recall-eval",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的检索评估：20–40 条真实问法（含换说法与编造题），输出 recall@1/@3/@5 与 MRR，报告落盘并带参数快照。只测量不调参；不可判的题剔除而不是记 0 分。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
