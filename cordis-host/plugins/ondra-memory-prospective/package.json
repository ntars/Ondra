{
  "name": "@ondra/cordis-plugin-ondra-memory-prospective",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的承诺与待办：承诺锁原文、越近越重的反向权重、kept/broken 结算只出关系增量建议；承诺进记忆（promise 类 8000 小时），待办不进记忆链。纯正则抽取，不调模型。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
