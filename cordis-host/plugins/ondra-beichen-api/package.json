{
  "name": "@ondra/cordis-plugin-ondra-beichen-api",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的北辰注册入口：本地生成主密钥、按 v1 分钟级 HMAC 铸令牌、验签后一跳 302 到注册页；页面不出现任何网址，邀请码只在跳转瞬间拼接。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
