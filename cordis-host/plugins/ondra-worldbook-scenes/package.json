{
  "name": "@ondra/cordis-plugin-ondra-worldbook-scenes",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的场景卡：从人设包的 references/scenes.md 逐字解析出「触发 / 表面 / 台词 / 动作 / 收尾 / 硬规则」，按关键词命中（带否定邻域保护）、同组互斥、递归 ≤3 算出一轮只用一张骨架；渲染时剔除「内心」栏——推演不是台词，写进提示词她会把心里话念出来。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
