{
  "name": "@ondra/cordis-plugin-ondra-emotion-project",
  "version": "2.0.1",
  "private": true,
  "description": "空谷 Ondra 的情感投影（手册 §2.6 / §4.3，P0 内感受铁律）：情绪的唯一文本出口。模板固定为「行为指令句 + 一条暗示」，禁止出现任何数字、维度名与情绪标签名，只给「有点提不起劲」这类主观表述。用户明确问数值时才允许转向 ui-api 的 /status；片段排序恒为正数（尾部），以守住前缀缓存。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@ntars/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
