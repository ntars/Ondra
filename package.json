{
  "name": "ondra",
  "productName": "空谷 Ondra",
  "description": "空谷 Ondra：全插件式桌面 AI 陪伴体应用",
  "version": "2.0.1",
  "private": true,
  "license": "AGPL-3.0",
  "author": {
    "name": "Ntarstudio（星玖工作室）",
    "url": "https://ai.ntars.cn/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ntars/Ondra.git"
  },
  "homepage": "https://ai.ntars.cn/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm run build:web && pnpm run build:plugins && pnpm run build:host && pnpm run build:sidecar",
    "build:web": "pnpm --filter @ondra/web run build",
    "build:host": "pnpm --filter @ondra/cordis-host run build",
    "build:sidecar": "pnpm --filter @ondra/dsh-sidecar run build",
    "build:plugins": "pnpm --filter \"./cordis-host/plugins/*\" --if-present run build",
    "dev:web": "pnpm --filter @ondra/web run dev",
    "dev:host": "pnpm --filter @ondra/cordis-host run dev",
    "dev:sidecar": "pnpm --filter @ondra/dsh-sidecar run dev",
    "dev:shell": "pnpm exec tauri dev",
    "tauri": "pnpm exec tauri",
    "build:app": "pnpm run build && pnpm run build:runtime && node tools/tauri-build.mjs && node tools/make-dmg.mjs && node tools/bundle-release.mjs",
    "release": "pnpm run build:app && node tools/bundle-release.mjs",
    "smoke": "node tools/smoke.mjs",
    "check:ui": "node tools/check-ui.mjs",
    "check:installer": "node tools/check-installer.mjs",
    "check:core": "node cordis-host/check-core.mjs",
    "prepare:plugins": "node tools/prepare-plugins.mjs",
    "site": "node tools/build-site.mjs",
    "build:runtime": "node tools/collect-runtime.mjs",
    "build:dmg": "node tools/make-dmg.mjs",
    "check:cors": "node tools/check-cors.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
