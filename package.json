{
  "name": "ondra",
  "productName": "空谷 Ondra",
  "description": "空谷 Ondra：全插件式桌面 AI 陪伴体应用",
  "version": "2.2.1",
  "private": true,
  "license": "AGPL-3.0",
  "author": {
    "name": "Ntarstudio（星玖工作室）",
    "url": "https://ai.ntars.cn/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ntars/Ondra.git"
  },
  "homepage": "https://ai.ntars.cn/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm run build:web && pnpm run build:plugins && pnpm run build:host && pnpm run build:sidecar",
    "build:web": "pnpm --filter @ondra/web run build",
    "build:host": "pnpm --filter @ondra/cordis-host run build",
    "build:sidecar": "pnpm --filter @ondra/dsh-sidecar run build",
    "build:plugins": "pnpm --filter \"./cordis-host/plugins/*\" --if-present run build",
    "dev:web": "pnpm --filter @ondra/web run dev",
    "dev:host": "pnpm --filter @ondra/cordis-host run dev",
    "dev:sidecar": "pnpm --filter @ondra/dsh-sidecar run dev",
    "dev:shell": "pnpm exec tauri dev",
    "tauri": "pnpm exec tauri",
    "build:app": "pnpm run build && pnpm run build:runtime && node tools/tauri-build.mjs && node tools/make-dmg.mjs && node tools/bundle-release.mjs",
    "release": "pnpm run build:app && node tools/bundle-release.mjs",
    "smoke": "node tools/smoke.mjs",
    "check:ui": "node tools/check-ui.mjs",
    "check:acceptance": "node tools/check-acceptance.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:brand": "node tools/gen-brand.mjs --check",
    "icons": "node tools/build-icons.mjs && node tools/build-tray-icons.mjs",
    "check:installer": "node tools/check-installer.mjs",
    "check:core": "node cordis-host/check-core.mjs",
    "check:wiring": "node cordis-host/check-wiring.mjs",
    "check:observability": "node cordis-host/check-observability.mjs",
    "check:logfmt": "node tools/check-log-format.mjs",
    "check:defaults": "node tools/check-defaults.mjs",
    "check:gap": "node cordis-host/check-gap.mjs",
    "check:gap-wake": "node cordis-host/check-gap-wake.mjs",
    "check:system-prompt": "node cordis-host/check-system-prompt.mjs",
    "check:prompt-context": "node cordis-host/check-prompt-context.mjs",
    "check:pack": "node cordis-host/check-pack.mjs",
    "check:emotion": "node cordis-host/check-emotion.mjs",
    "check:project": "node cordis-host/check-emotion-project.mjs",
    "check:feel": "node cordis-host/check-feel.mjs",
    "check:diffuse": "node cordis-host/check-diffuse.mjs",
    "check:relation": "node cordis-host/check-relation.mjs",
    "check:evolve": "node cordis-host/check-evolve.mjs",
    "check:drift": "node cordis-host/check-drift.mjs",
    "check:kernel-system": "node tools/check-kernel-system.mjs",
    "check:host-persona": "node tools/check-host-persona.mjs",
    "check:e2e": "node tools/check-e2e-proactive.mjs",
    "check:e2e-memory": "node tools/check-e2e-memory.mjs",
    "check:voice": "node tools/check-voice.mjs",
    "check:plugins": "node tools/check-plugins.mjs",
    "check:intake-switch": "node tools/check-intake-switch.mjs",
    "check:no-reason": "node tools/check-proactive-noreason.mjs",
    "check:order": "node tools/check-store-order.mjs",
    "check:filter": "node tools/check-filter.mjs",
    "check:stale": "node tools/check-stale.mjs",
    "prepare:plugins": "node tools/prepare-plugins.mjs",
    "ondra": "node tools/ondra.mjs",
    "site": "node tools/build-site.mjs",
    "build:runtime": "node tools/collect-runtime.mjs",
    "build:dmg": "node tools/make-dmg.mjs",
    "check:cors": "node tools/check-cors.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
