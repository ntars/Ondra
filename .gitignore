# 依赖目录
node_modules/
.pnpm-store/
.pnpm-debug.log*

# 构建产物
build/
dist/
out/
release/
.desktop-build/
*.tsbuildinfo
*.asar
*.dmg
*.exe
*.AppImage
*.snap

# 素材库：本地工作素材，整目录不入库。
# 随仓库分发的内容（出厂人设、角色素材、品牌图、开发手册）已复制到 content/。
material/

# 例外：上面的 release/ 本意是忽略打包产物，但它无前缀匹配任意层级，
# 连构建链的源码目录也一并吞了（desktop/scripts/build.ts 直接 import
# ./release/process.ts）。少了它，云端 checkout 后 pnpm run build 会以
# ERR_MODULE_NOT_FOUND 失败。故把该目录显式放回版本控制。
!desktop/scripts/release/
!desktop/scripts/release/**

# 注意：不全局排除 *.zip 与 *.tar.gz
# cordis/ondra-persona-skills/ 下的人格包与 material/ 下的素材包属于源码资产，必须入库。

# 工具链缓存（体积大，可由安装器重建）
toolchain/

# 备份与本地工作目录
.backup/
.workbuddy/
# 开发过程笔记与技能：非构建依赖，不入库（clone 后不影响安装与构建）
desktop/.agents/
.trash/
tmp/
.tmp/

# 系统与编辑器
.DS_Store
._*
__MACOSX/
.idea/
.vscode/
*.swp

# 日志与运行时文件
*.log
logs/
*.pid
.pid

# 环境与密钥（绝不入库）
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# 根 .gitignore 补充

# 测试与工具链的临时产物：用例每次运行都会重新生成，内容随机
desktop/apps/desktop/tests/cache-test-*/
desktop/scripts/staged-lint-probe-*.ts
desktop/examples/oxlint-contract-*/

# Cordis 插件的编译产物（tsc -b 生成，不入库）
cordis/*/lib/
