{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "空谷 Ondra",
  "version": "2.0.1",
  "identifier": "com.ntars.ondra",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "空谷 Ondra",
        "width": 820,
        "height": 580,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 16
        },
        "backgroundColor": "#FFFDF9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/cordis-host": "cordis-host",
      "runtime/dsh-sidecar": "dsh-sidecar",
      "runtime/node": "node",
      "tray": "tray"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi"
      }
    }
  }
}
