{
  "name": "@ntars/ondra-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@ntars/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-output-retention": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-spill": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-output-retention": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-spill": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*"
  }
}
