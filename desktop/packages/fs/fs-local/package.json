{
  "name": "@ntars/ondra-fs-local",
  "description": "Local-filesystem implementation of the Ondra filesystem seam (ctx.fs)",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-fs": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "koffi": "3.1.1",
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-fs": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
