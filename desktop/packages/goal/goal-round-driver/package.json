{
  "name": "@ntars/ondra-goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-goal": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-subagent": "workspace:*"
  },
  "devDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-goal": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ntars/ondra-subagent": {
      "optional": true
    }
  }
}
