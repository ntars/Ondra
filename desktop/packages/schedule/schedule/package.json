{
  "name": "@ntars/ondra-schedule",
  "description": "Host-wide durable reminders with shared management and original-Session delivery",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-api-session-controller": "workspace:*",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-storage-domain": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-util-time": "workspace:*",
    "@ntars/ondra-workspace": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-api-session-controller": "workspace:*",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-storage": "workspace:*",
    "@ntars/ondra-storage-domain": "workspace:*",
    "@ntars/ondra-storage-json": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-util-time": "workspace:*",
    "@ntars/ondra-workspace": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
