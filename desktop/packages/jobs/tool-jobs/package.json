{
  "name": "@ntars/ondra-tool-jobs",
  "description": "Model-facing background job control tools (job_output, job_list, job_kill) over the ctx.jobs registry",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/jobs/tool-jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-output-retention": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-jobs": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-output-retention": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-jobs": "workspace:*",
    "@ntars/ondra-jobs-local": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
