{
  "name": "@ntars/ondra-jobs-local",
  "description": "Process-local implementation of the Ondra background job registry seam",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-jobs": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis-plugin-include": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-jobs": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
