{
  "name": "@ntars/ondra-sdk-client",
  "description": "TypeScript client SDK for driving a Ondra runtime subprocess over stdio JSON-RPC: the Ondra high-level turns API and the lower-level HarnessClient",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/ondra": "workspace:*"
  },
  "peerDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-sdk-protocol": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-sdk-protocol": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-experimental-translator": "workspace:*"
  }
}
