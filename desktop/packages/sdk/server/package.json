{
  "name": "@ntars/ondra-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Ondra SDK clients",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek-api-key": "workspace:*",
    "@ntars/ondra-schedule": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-sdk-protocol": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-user-approval": "workspace:*",
    "@ntars/ondra-user-questions": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek-api-key": "workspace:*",
    "@ntars/ondra-schedule": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-sdk-protocol": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-user-approval": "workspace:*",
    "@ntars/ondra-user-questions": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*"
  }
}
