{
  "name": "@ntars/ondra-sdk-protocol",
  "description": "Shared wire protocol for the Ondra SDK runtime: the newline-delimited JSON-RPC stdio transport and the named request, result, and notification types spoken between the runtime server and SDK clients",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/sdk/protocol"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-user-questions": "workspace:*"
  },
  "devDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-user-questions": "workspace:*"
  }
}
