{
  "name": "@ntars/ondra-hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the Ondra interception seams",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-hook-protocol": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-shell": "workspace:*",
    "@ntars/ondra-bash-local": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-hook-protocol": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*",
    "@ntars/ondra-fs-local": "workspace:*"
  }
}
