{
  "name": "@ntars/ondra-experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the Ondra PTC execution seam",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "py/**/*.py",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-ptc-runtime": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/ondra-sandbox": "workspace:*",
    "@ntars/ondra-sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@ntars/ondra-ptc-runtime": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/ondra-sandbox": "workspace:*",
    "@ntars/ondra-sandbox-policy": "workspace:*",
    "@ntars/ondra-sandbox-local": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-session": "workspace:*"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  }
}
