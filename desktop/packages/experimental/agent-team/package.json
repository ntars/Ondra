{
  "name": "@ntars/ondra-experimental-agent-team",
  "description": "Implicit-root Agent Teams roster, direct peer messaging, and shared task DAG",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-session-query": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-subagent-fork-in-process": "workspace:*",
    "@ntars/ondra-subagent-spawn-in-process": "workspace:*"
  }
}
