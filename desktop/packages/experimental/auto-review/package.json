{
  "name": "@ntars/ondra-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Ondra Auto permission preset",
  "version": "1.2.0",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-instructions": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-permission-presets": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-working-directory": "workspace:*"
  },
  "dependencies": {
    "@ntars/ondra-util-values": "workspace:*"
  },
  "devDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-instructions": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-bash-sandbox": "workspace:*",
    "@ntars/ondra-compaction": "workspace:*",
    "@ntars/ondra-fs-local": "workspace:*",
    "@ntars/ondra-fs-observation-policy": "workspace:*",
    "@ntars/ondra-fs-sandbox": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek": "workspace:*",
    "@ntars/ondra-llm-deepseek-api-key": "workspace:*",
    "@ntars/ondra-permission-presets": "workspace:*",
    "@ntars/ondra-ptc-runtime-node": "workspace:*",
    "@ntars/ondra-sandbox": "workspace:*",
    "@ntars/ondra-sandbox-policy": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-shell": "workspace:*",
    "@ntars/ondra-shell-env": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tool-bash": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-executor-ptc": "workspace:*",
    "@ntars/ondra-tool-fs": "workspace:*",
    "@ntars/ondra-tool-subagent": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-user-approval": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
