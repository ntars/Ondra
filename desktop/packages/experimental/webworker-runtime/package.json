{
  "name": "@ntars/ondra-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@ntars/ondra-util-crypto": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.18.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.7",
    "readable-stream": "^4.7.0",
    "@ntars/ondra-client-web": "workspace:*",
    "string_decoder": "^1.3.0"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-client-modules": "workspace:*",
    "@ntars/ondra-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-api-gateway": "workspace:*",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-bash-sandbox": "workspace:*",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-client-file-upload": "workspace:*",
    "@ntars/ondra-client-modules": "workspace:*",
    "@ntars/ondra-host-webserver": "workspace:*",
    "@ntars/ondra-sandbox-local": "workspace:*",
    "@ntars/ondra-sandbox-policy": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/node-addon-system": "workspace:~",
    "@types/picomatch": "^4.0.3",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
