{
  "name": "@ntars/ondra-cua",
  "description": "Shared Computer Use application objects, authorization, and logged tool execution",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/cua"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    },
    "./bridge": {
      "types": "./lib/types/bridge.d.ts",
      "default": "./lib/bridge.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/remote-types.js"
    },
    "./native-client": {
      "types": "./lib/types/native-client.d.ts",
      "default": "./lib/native-client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/remote-types.js",
    "lib/api.js",
    "lib/bridge.js",
    "lib/native-client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-user-questions": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-ptc-runtime-node": "workspace:*"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@ntars/ondra-atomic-write": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-computer-use": "workspace:*",
    "@ntars/ondra-storage-domain": "workspace:*"
  },
  "devDependencies": {
    "@ntars/ondra-working-directory": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-include": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-attachment-local": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-fs-local": "workspace:*",
    "@ntars/ondra-llm-deepseek": "workspace:*",
    "@ntars/ondra-ptc-runtime-node": "workspace:*",
    "@ntars/ondra-sandbox-local": "workspace:*",
    "@ntars/ondra-sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@ntars/ondra-ptc-runtime": "workspace:*",
    "@ntars/ondra-user-questions": "workspace:*",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-config-editor": "workspace:*",
    "@ntars/ondra-hmr": "workspace:*",
    "@ntars/cordis-plugin-timer": "workspace:~",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-agent-preset-registry": "workspace:*",
    "@ntars/ondra-api-remotes": "workspace:*",
    "@ntars/ondra-api-gateway": "workspace:*",
    "@ntars/ondra-client-locale": "workspace:*",
    "@ntars/ondra-client-store": "workspace:*",
    "@ntars/ondra-client-ui-primitives": "workspace:*",
    "@ntars/ondra-client-ui-renderer": "workspace:*",
    "@ntars/ondra-client-ui-slots": "workspace:*",
    "@ntars/ondra-client-ui-plugin-manager": "workspace:*",
    "@ntars/ondra-client-ui-settings": "workspace:*",
    "@ntars/ondra-client-ui-layout": "workspace:*",
    "@ntars/ondra-client-test-runtime": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.1.0",
    "@ntars/ondra-loader-smoke": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-storage": "workspace:*",
    "@ntars/ondra-storage-json": "workspace:*",
    "@ntars/ondra-client-ui-user-questions": "workspace:*",
    "@ntars/ondra-client-ui-approval": "workspace:*",
    "@ntars/ondra-client-ui-conversation": "workspace:*"
  },
  "ondra": {
    "client": {
      "inject": [
        "@ntars/ondra-api-remotes",
        "@ntars/ondra-client-locale",
        "@ntars/ondra-client-ui-plugin-manager",
        "@ntars/ondra-client-ui-settings",
        "@ntars/ondra-client-ui-layout",
        "@ntars/ondra-client-ui-user-questions",
        "@ntars/ondra-client-ui-approval",
        "@ntars/ondra-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
