{
  "name": "@ntars/ondra-webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed Ondra Sessions",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-default-model": "workspace:*",
    "@ntars/ondra-agent-preset-registry": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-permission-presets": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-title": "workspace:*",
    "@ntars/ondra-workspace": "workspace:*"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-include": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-default-model": "workspace:*",
    "@ntars/ondra-agent-preset-registry": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-permission-presets": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-title": "workspace:*",
    "@ntars/ondra-workspace": "workspace:*"
  },
  "dependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*"
  }
}
