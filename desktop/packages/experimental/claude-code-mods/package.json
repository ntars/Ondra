{
  "name": "@ntars/ondra-experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on Ondra extension points",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/ondra-util-crypto": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-commands": "workspace:*",
    "@ntars/ondra-fs": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-storage-domain": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-user-questions": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-include": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-commands": "workspace:*",
    "@ntars/ondra-fs": "workspace:*",
    "@ntars/ondra-fs-local": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-storage": "workspace:*",
    "@ntars/ondra-storage-domain": "workspace:*",
    "@ntars/ondra-storage-json": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-user-questions": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*"
  }
}
