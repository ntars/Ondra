{
  "name": "@ntars/ondra-personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "1.2.0",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/ondra-action-cards": "workspace:*",
    "@ntars/ondra-client-ui-action-cards": "workspace:*",
    "@ntars/ondra-creation-recommendations": "workspace:*",
    "@ntars/ondra-client-ui-creation-recommendations": "workspace:*",
    "@ntars/ondra-plugin-recommendations": "workspace:*",
    "@ntars/ondra-client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@ntars/cordis-plugin-timer": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-api-remote-access": "workspace:*",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-hmr": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-plugin-manager": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-skill": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tools": "workspace:*"
  },
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
