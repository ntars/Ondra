{
  "name": "@ntars/ondra-experimental-client-ui-agent-team",
  "description": "Web Agent Teams roster, task board, and teammate navigation",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/client-ui-agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "ondra": {
    "client": {
      "inject": [
        "@ntars/ondra-api-session-controller",
        "@ntars/ondra-client-locale",
        "@ntars/ondra-client-ui-conversation",
        "@ntars/ondra-client-ui-primitives",
        "@ntars/ondra-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-api-session-controller": "workspace:*",
    "@ntars/ondra-client-locale": "workspace:*",
    "@ntars/ondra-client-store": "workspace:*",
    "@ntars/ondra-client-test-runtime": "workspace:*",
    "@ntars/ondra-client-ui-conversation": "workspace:*",
    "@ntars/ondra-client-ui-primitives": "workspace:*",
    "@ntars/ondra-client-ui-renderer": "workspace:*",
    "@ntars/ondra-client-ui-session": "workspace:*",
    "@ntars/ondra-client-ui-slots": "workspace:*",
    "@ntars/ondra-client-ui-workspace": "workspace:*",
    "@ntars/ondra-experimental-agent-team": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@ntars/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ntars/ondra-agent": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
