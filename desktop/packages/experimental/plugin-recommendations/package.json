{
  "name": "@ntars/ondra-plugin-recommendations",
  "description": "Official plugin suggestions with explicit user activation and persistent conversation decisions",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/plugin-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-skill": "workspace:*"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-plugin-manager": "workspace:*",
    "@ntars/ondra-package-manifest": "workspace:*",
    "@ntars/ondra-api-remote-access": "workspace:*",
    "@ntars/ondra-skill": "workspace:*"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@ntars/ondra-client-ui-plugin-recommendations": "workspace:*",
    "@ntars/ondra-action-cards": "workspace:*",
    "@ntars/ondra-client-ui-action-cards": "workspace:*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "icon": "./icon.svg"
}
