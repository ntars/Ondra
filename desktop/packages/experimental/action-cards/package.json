{
  "name": "@ntars/ondra-action-cards",
  "description": "Optional action cards below answers: one shared proposal tool, card state, user actions and status notices",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/experimental/action-cards"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-session": "workspace:*"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-api-remote-access": "workspace:*",
    "@ntars/ondra-sandbox-policy": "workspace:*",
    "@ntars/ondra-skill": "workspace:*",
    "@ntars/ondra-tool-skill": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
