{
  "name": "@ntars/ondra-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Ondra web capability seam (ctx.web)",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-web": "workspace:*"
  },
  "dependencies": {
    "@ntars/ondra-output-retention": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-spill-local": "workspace:*",
    "@ntars/ondra-spill-policy": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tool-call-timeout-policy": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-web": "workspace:*",
    "@ntars/ondra-web-fetch-http": "workspace:*",
    "@ntars/ondra-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*"
  }
}
