{
  "name": "@ntars/ondra-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the Ondra web capability seam (ctx.web)",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-credentials": "workspace:*",
    "@ntars/ondra-deepseek-account": "workspace:*",
    "@ntars/ondra-launch-environment": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-web": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-credentials": "workspace:*",
    "@ntars/ondra-credentials-local": "workspace:*",
    "@ntars/ondra-deepseek-account": "workspace:*",
    "@ntars/ondra-launch-environment": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-web": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ntars/ondra-deepseek-account": {
      "optional": true
    }
  }
}
