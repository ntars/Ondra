{
  "name": "@ntars/ondra-shell-env",
  "description": "Tool-independent managed ONDRA_* shell environment registry",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/shell/shell-env"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-home-paths": "workspace:*",
    "@ntars/ondra-shell": "workspace:*",
    "@ntars/ondra-tools": "workspace:*"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-home-paths": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-shell": "workspace:*",
    "@ntars/ondra-tools": "workspace:*"
  }
}
