{
  "name": "@ntars/ondra-bash-local",
  "description": "Local-subprocess implementation of the Ondra bash executor seam",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/shell/bash-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-shell": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-shell": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
