{
  "name": "@ntars/ondra-plugin-market",
  "description": "Configured plugin market indexes for the Web Discover page and the plugin_market agent tool",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/boot/plugin-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-atomic-write": "workspace:*",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-package-manifest": "workspace:*",
    "@ntars/ondra-plugin-detail": "workspace:*",
    "@ntars/ondra-plugin-market-index": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "hosted-git-info": "^9.0.3",
    "minisearch": "^7.2.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-plugin-manager": "workspace:*",
    "@ntars/ondra-settings": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ntars/ondra-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/cosmokit": "workspace:~",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-config-editor": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-plugin-manager": "workspace:*",
    "@ntars/ondra-settings": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@types/hosted-git-info": "^3.0.5",
    "@types/semver": "^7.8.0"
  }
}
