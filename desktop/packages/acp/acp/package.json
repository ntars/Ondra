{
  "name": "@ntars/ondra-acp",
  "description": "Automation-only Agent Client Protocol server for driving Ondra agents over JSON-RPC stdio",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-mcp-client": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*",
    "@ntars/ondra-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ntars/ondra-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-mcp-client": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-user-approval": "workspace:*"
  }
}
