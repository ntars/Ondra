{
  "name": "@ntars/ondra-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "ondra": {
    "client": {
      "inject": [
        "@ntars/ondra-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@ntars/ondra-deque": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-scope": "workspace:*"
  },
  "devDependencies": {
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-preset-registry": "workspace:*",
    "@ntars/ondra-api-gateway": "workspace:*",
    "@ntars/ondra-api-job-controller": "workspace:*",
    "@ntars/ondra-api-session-controller": "workspace:*",
    "@ntars/ondra-api-settings-controller": "workspace:*",
    "@ntars/ondra-api-workspace-controller": "workspace:*",
    "@ntars/ondra-api-workspace-files": "workspace:*",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-client-file-upload": "workspace:*",
    "@ntars/ondra-commands": "workspace:*",
    "@ntars/ondra-cordis-host-runner": "workspace:*",
    "@ntars/ondra-credentials": "workspace:*",
    "@ntars/ondra-file-reference": "workspace:*",
    "@ntars/ondra-goal": "workspace:*",
    "@ntars/ondra-host-plugin-inventory": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-message-feedback": "workspace:*",
    "@ntars/ondra-permission-presets": "workspace:*",
    "@ntars/ondra-schedule": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-reference": "workspace:*",
    "@ntars/ondra-settings": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-user-approval": "workspace:*",
    "@ntars/ondra-user-questions": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "zod": "4.4.3",
    "@ntars/ondra-command-feedback": "workspace:*",
    "@ntars/ondra-api-terminal-controller": "workspace:*",
    "@ntars/ondra-plugin-manager": "workspace:*",
    "@ntars/ondra-plugin-market": "workspace:*",
    "@ntars/ondra-client-ui-plugin-manager": "workspace:*",
    "@ntars/ondra-office-to-pdf": "workspace:*",
    "@ntars/ondra-api-account-controller": "workspace:*",
    "@ntars/ondra-deepseek-account": "workspace:*",
    "@ntars/ondra-client-product-analytics": "workspace:*",
    "@ntars/ondra-client-ui-trajectory": "workspace:*"
  }
}
