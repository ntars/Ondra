    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-session-projection-cache": "workspace:*",
    "@ntars/ondra-session-query": "workspace:*",
    "@ntars/ondra-session-title": "workspace:*",
    "@ntars/ondra-settings": "workspace:*",
    "@ntars/ondra-skill": "workspace:*",
    "@ntars/ondra-storage": "workspace:*",
    "@ntars/ondra-storage-domain": "workspace:*",
    "@ntars/ondra-storage-json": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-typert-registry": "workspace:*",
    "@ntars/ondra-util-crypto": "workspace:*",
