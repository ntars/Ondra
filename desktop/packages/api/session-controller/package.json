{
  "name": "@ntars/ondra-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "ondra": {
    "client": {
      "external": [
        "@ntars/ondra-api-gateway/client"
      ],
      "inject": [
        "@ntars/ondra-api-gateway",
        "@ntars/ondra-client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-deque": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-default-model": "workspace:*",
    "@ntars/ondra-agent-preset-registry": "workspace:*",
    "@ntars/ondra-api-gateway": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-client-file-upload": "workspace:*",
    "@ntars/ondra-commands": "workspace:*",
    "@ntars/ondra-credentials": "workspace:*",
    "@ntars/ondra-file-reference": "workspace:*",
    "@ntars/ondra-fs": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-native-command": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-session-projection-cache": "workspace:*",
    "@ntars/ondra-session-query": "workspace:*",
    "@ntars/ondra-session-title": "workspace:*",
    "@ntars/ondra-settings": "workspace:*",
    "@ntars/ondra-skill": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-typert-registry": "workspace:*",
    "@ntars/ondra-util-time": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/ondra-util-workspace-path": "workspace:*",
    "@ntars/ondra-workspace": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ntars/ondra-session-persistence": {
      "optional": true
    },
    "@ntars/ondra-session-projection-cache": {
      "optional": true
    },
    "@ntars/ondra-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ntars/ondra-api-remote-access": "workspace:*",
