{
  "name": "@ntars/ondra-session-title-first-prompt-llm",
  "description": "First-message LLM provider plugin for Ondra session titles",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/session/session-title-first-prompt-llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-title": "workspace:*",
    "@ntars/ondra-session-title-llm": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis-plugin-include": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek": "workspace:*",
    "@ntars/ondra-llm-deepseek-api-key": "workspace:*",
    "@ntars/ondra-llm-pi-ai": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-title": "workspace:*",
    "@ntars/ondra-session-title-llm": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*"
  }
}
