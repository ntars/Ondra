{
  "name": "@ntars/ondra-session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the Ondra",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/session/session-persistence-jsonl"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session-format": "workspace:*",
    "@ntars/ondra-session-format-catalog": "workspace:*",
    "@ntars/ondra-session-format-v3-to-v4": "workspace:*",
    "@ntars/node-addon-system": "workspace:~",
    "@ntars/schemastery": "workspace:~",
    "koffi": "3.1.1",
    "p-limit": "7.3.3"
  },
  "devDependencies": {
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-format-v0-to-v1": "workspace:*",
    "@ntars/ondra-session-persistence": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
