{
  "name": "@ntars/ondra-subagent-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Ondra runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/subagent/subagent-ondra-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-sdk-client": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*"
  },
  "dependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-instructions": "workspace:*",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek": "workspace:*",
    "@ntars/ondra-llm-deepseek-api-key": "workspace:*",
    "@ntars/ondra-loader-smoke": "workspace:*",
    "@ntars/ondra-sdk-client": "workspace:*",
    "@ntars/ondra-sdk-protocol": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-checkpoint-policy": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-skill-filesystem": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tool-subagent": "workspace:*"
  }
}
