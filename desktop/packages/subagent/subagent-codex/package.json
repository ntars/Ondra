{
  "name": "@ntars/ondra-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*"
  },
  "dependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-sdk-protocol": "workspace:*",
    "@ntars/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@ntars/ondra-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-loader-smoke": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-checkpoint-policy": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-subprocess": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/ondra-tool-jobs": "workspace:*",
    "@ntars/ondra-tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
