{
  "name": "@ntars/ondra-system-prompt",
  "description": "System prompt assembly registry for the Ondra",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/core/system-prompt"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
