{
  "name": "@ntars/ondra-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the Ondra",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/ondra-workspace": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@ntars/ondra-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-scope": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-typert-protocol": "workspace:*",
    "@ntars/ondra-typert-registry": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/ondra-workspace": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "zod": "4.4.3"
  }
}
