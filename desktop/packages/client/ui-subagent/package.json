{
  "name": "@ntars/ondra-client-ui-subagent",
  "description": "Subagent conversation catalog, continuation routing UI, and '@' reference source",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/client/ui-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "ondra": {
    "client": {
      "inject": [
        "@ntars/ondra-api-session-controller",
        "@ntars/ondra-client-locale",
        "@ntars/ondra-client-resources",
        "@ntars/ondra-client-ui-chat",
        "@ntars/ondra-client-ui-conversation",
        "@ntars/ondra-client-ui-primitives",
        "@ntars/ondra-client-ui-sidebar-right",
        "@ntars/ondra-client-ui-input-trigger",
        "@ntars/ondra-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-client-locale": "workspace:*",
    "@ntars/ondra-client-resources": "workspace:*",
    "@ntars/ondra-client-test-runtime": "workspace:*",
    "@ntars/ondra-client-ui-chat": "workspace:*",
    "@ntars/ondra-client-ui-conversation": "workspace:*",
    "@ntars/ondra-client-ui-input-trigger": "workspace:*",
    "@ntars/ondra-client-ui-primitives": "workspace:*",
    "@ntars/ondra-client-ui-slots": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ntars/ondra-api-session-controller": "workspace:*",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-client-ui-renderer": "workspace:*",
    "@ntars/ondra-client-ui-sidebar-right": "workspace:*",
    "@ntars/ondra-client-ui-session": "workspace:*",
    "@ntars/ondra-client-ui-workspace": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
