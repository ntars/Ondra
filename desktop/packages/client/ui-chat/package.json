{
  "name": "@ntars/ondra-client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./assets/*": "./lib/assets/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "ondra": {
    "client": {
      "inject": [
        "@ntars/ondra-api-session-controller",
        "@ntars/ondra-api-workspace-controller",
        "@ntars/ondra-client-connection",
        "@ntars/ondra-client-locale",
        "@ntars/ondra-client-ui-conversation",
        "@ntars/ondra-client-ui-input-trigger",
        "@ntars/ondra-client-ui-layout",
        "@ntars/ondra-client-ui-renderer",
        "@ntars/ondra-client-ui-session",
        "@ntars/ondra-client-ui-settings",
        "@ntars/ondra-client-ui-sidebar-right",
        "@ntars/ondra-client-ui-workspace",
        "@ntars/ondra-client-ui-file-drag"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-api-remotes": "workspace:*",
    "@ntars/ondra-api-session-controller": "workspace:*",
    "@ntars/ondra-api-workspace-controller": "workspace:*",
    "@ntars/ondra-api-workspace-files": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-client-locale": "workspace:*",
    "@ntars/ondra-client-store": "workspace:*",
    "@ntars/ondra-client-ui-approval": "workspace:*",
    "@ntars/ondra-client-ui-conversation": "workspace:*",
    "@ntars/ondra-client-ui-input-trigger": "workspace:*",
    "@ntars/ondra-client-ui-layout": "workspace:*",
    "@ntars/ondra-client-ui-primitives": "workspace:*",
    "@ntars/ondra-client-ui-renderer": "workspace:*",
    "@ntars/ondra-client-ui-session": "workspace:*",
    "@ntars/ondra-client-ui-settings": "workspace:*",
    "@ntars/ondra-client-ui-sidebar-browser": "workspace:*",
    "@ntars/ondra-client-ui-sidebar-documentpreview": "workspace:*",
    "@ntars/ondra-client-ui-sidebar-right": "workspace:*",
    "@ntars/ondra-client-ui-slots": "workspace:*",
    "@ntars/ondra-client-ui-workspace": "workspace:*",
    "@ntars/ondra-commands": "workspace:*",
    "@ntars/ondra-compaction": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-retry": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-stats": "workspace:*",
    "@ntars/ondra-session-turn-outline": "workspace:*",
    "@ntars/ondra-subagent": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*",
    "@ntars/ondra-util-workspace-path": "workspace:*",
    "@ntars/ondra-tool-executor-ptc": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ntars/ondra-settings": "workspace:*",
    "@ntars/ondra-client-product-analytics": "workspace:*",
    "@ntars/ondra-client-ui-file-drag": "workspace:*"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/assets",
    "lib/types/**/*.d.ts"
  ]
}
