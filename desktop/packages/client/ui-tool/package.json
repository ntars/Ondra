{
  "name": "@ntars/ondra-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "ondra": {
    "client": {
      "inject": [
        "@ntars/ondra-api-workspace-controller",
        "@ntars/ondra-client-connection",
        "@ntars/ondra-client-locale",
        "@ntars/ondra-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/ondra-spill-policy": "workspace:*",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-executor-ptc": "workspace:*",
    "@ntars/ondra-tool-jobs": "workspace:*",
    "@ntars/ondra-tool-session-query": "workspace:*",
    "@ntars/ondra-tool-terminal": "workspace:*",
    "@ntars/ondra-spill": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-api-remotes": "workspace:*",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-client-locale": "workspace:*",
    "@ntars/ondra-client-test-runtime": "workspace:*",
    "@ntars/ondra-client-ui-conversation": "workspace:*",
    "@ntars/ondra-client-ui-primitives": "workspace:*",
    "@ntars/ondra-client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ntars/ondra-api-workspace-controller": "workspace:*",
    "@ntars/ondra-client-ui-chat": "workspace:*",
    "@ntars/ondra-client-ui-renderer": "workspace:*",
    "@ntars/ondra-client-ui-session": "workspace:*",
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/ondra-util-workspace-path": "workspace:*",
    "@ntars/ondra-attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@ntars/ondra-ptc-runtime": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*",
    "@ntars/ondra-user-questions": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
