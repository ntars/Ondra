{
  "name": "@ntars/ondra-llm-retry",
  "description": "Provider-routed LLM request retry policy for the Ondra",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-session-projection": "workspace:*"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/cordis-plugin-include": "workspace:~",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek": "workspace:*",
    "@ntars/ondra-llm-deepseek-api-key": "workspace:*",
    "@ntars/ondra-llm-mock-server": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
