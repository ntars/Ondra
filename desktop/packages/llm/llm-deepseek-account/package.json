    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek": "workspace:*",
    "@ntars/ondra-launch-environment": "workspace:*",
    "@ntars/ondra-deepseek-account": "workspace:*",
    "@ntars/cordis-plugin-loader": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek": "workspace:*",
    "@ntars/ondra-launch-environment": "workspace:*",
    "@ntars/ondra-deepseek-account": "workspace:*",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/ondra-llm-deepseek-api-key": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ntars/ondra-deepseek-account": {
      "optional": true
    },
    "@ntars/cordis-plugin-loader": {
      "optional": true
    }
  }
