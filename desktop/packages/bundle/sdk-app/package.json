{
  "name": "@ntars/ondra-sdk-app",
  "description": "The ondra SDK profile bundle: stdio JSON-RPC serving and process lifecycle over ondra-base",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@ntars/ondra-cmdline": "workspace:*",
    "@ntars/ondra-sdk-jsonrpc-server": "workspace:*",
    "@ntars/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@ntars/ondra-skill-office": "workspace:*",
    "@ntars/ondra-tool-workspace-dependencies": "workspace:*",
    "@ntars/ondra-client-connection": "workspace:*",
    "@ntars/ondra-client-file-upload": "workspace:*",
    "@ntars/ondra-workspace": "workspace:*",
    "@ntars/ondra-schedule": "workspace:*",
    "@ntars/ondra-time-context": "workspace:*",
    "@ntars/ondra-tool-schedule": "workspace:*",
    "@ntars/ondra-tool-ask-user": "workspace:*",
    "@ntars/ondra-tool-present": "workspace:*",
    "@ntars/ondra-file-reference-local": "workspace:*",
    "@ntars/ondra-deliverable-file-references": "workspace:*"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis-plugin-include": "workspace:~",
    "@ntars/cordis": "workspace:~"
  }
}
