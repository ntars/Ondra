{
  "name": "@ntars/ondra-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@ntars/cordis-plugin-timer": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-agent-loop": "workspace:*",
    "@ntars/ondra-attachment-local": "workspace:*",
    "@ntars/ondra-compaction-basic": "workspace:*",
    "@ntars/ondra-compaction-image-offload": "workspace:*",
    "@ntars/ondra-deepseek-llm-api-extensions": "workspace:*",
    "@ntars/ondra-jobs-local": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-llm-deepseek-api-key": "workspace:*",
    "@ntars/ondra-llm-retry": "workspace:*",
    "@ntars/ondra-mcp-resources": "workspace:*",
    "@ntars/ondra-plugin-package-inventory-deepseek": "workspace:*",
    "@ntars/ondra-sandbox-local": "workspace:*",
    "@ntars/ondra-sandbox-policy": "workspace:*",
    "@ntars/ondra-sdk-app": "workspace:*",
    "@ntars/ondra-sdk-jsonrpc-server": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-session-checkpoint-policy": "workspace:*",
    "@ntars/ondra-session-log-deepseek": "workspace:*",
    "@ntars/ondra-session-persistence-jsonl": "workspace:*",
    "@ntars/ondra-session-projection": "workspace:*",
    "@ntars/ondra-session-title": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-terminal": "workspace:*",
    "@ntars/ondra-terminal-bash": "workspace:*",
    "@ntars/ondra-token-meter": "workspace:*",
    "@ntars/ondra-tool-bash-persistent": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-fs": "workspace:*",
    "@ntars/ondra-tool-pwsh-persistent": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*",
    "@ntars/ondra-tool-working-directory": "workspace:*",
    "@ntars/ondra-fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~"
  }
}
