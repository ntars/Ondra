{
  "name": "@ntars/ondra-settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Ondra",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-brand": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/schemastery": "workspace:~",
    "@ntars/cordis-plugin-timer": "workspace:~",
    "@ntars/ondra-app-boot": "workspace:*",
    "@ntars/ondra-hmr": "workspace:*",
    "@ntars/ondra-agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/ondra-config-editor": "workspace:*",
    "@ntars/cordis-plugin-loader": "workspace:~",
    "@ntars/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
