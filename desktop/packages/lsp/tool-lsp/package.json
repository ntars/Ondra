{
  "name": "@ntars/ondra-tool-lsp",
  "description": "Model-facing lsp tool over the Ondra LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-lsp": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*"
  },
  "dependencies": {
    "@ntars/ondra-util-values": "workspace:*",
    "@ntars/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@ntars/ondra-agent": "workspace:*",
    "@ntars/ondra-fs-local": "workspace:*",
    "@ntars/ondra-llm": "workspace:*",
    "@ntars/ondra-lsp": "workspace:*",
    "@ntars/ondra-lsp-stdio": "workspace:*",
    "@ntars/ondra-session": "workspace:*",
    "@ntars/ondra-subprocess-local": "workspace:*",
    "@ntars/ondra-system-prompt": "workspace:*",
    "@ntars/ondra-timeout": "workspace:*",
    "@ntars/ondra-tool-call-timeout-policy": "workspace:*",
    "@ntars/ondra-tool-executor-native": "workspace:*",
    "@ntars/ondra-tool-testkit": "workspace:*",
    "@ntars/ondra-tools": "workspace:*",
    "@ntars/ondra-working-directory": "workspace:*",
    "@ntars/ondra-agent-loop-testkit": "workspace:*"
  }
}
