{
  "name": "@ntars/ondra-storage-domain",
  "description": "Domain data form (ctx.storage.domain): schema-validated, event-emitting KV domains over storage backends for the Ondra",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntars/Ondra.git",
    "directory": "packages/storage/storage-domain"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ntars/ondra-storage": "workspace:*",
    "@ntars/cordis": "workspace:~"
  },
  "dependencies": {
    "@ntars/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ntars/ondra-storage": "workspace:*",
    "@ntars/cordis": "workspace:~"
  }
}
