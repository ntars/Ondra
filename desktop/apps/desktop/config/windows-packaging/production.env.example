# Copy to production.env in the same machine configuration directory and fill in the values.
ONDRA_DESKTOP_APP_ID=com.deepseek.ondra
ONDRA_DESKTOP_AUTO_UPDATE_ENV=production
ONDRA_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
ONDRA_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# ONDRA_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
ONDRA_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
ONDRA_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
