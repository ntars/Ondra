{
  "name": "ondra-grow",
  "description": "空谷 Ondra 的养成系统（L9 扩展池）：把相处天数、互动次数、活跃记忆条数、关系阶序四项既有读数归一化加权成一条里程分，落进五档（萌芽/抽枝/成荫/开花/结果），并给一句不含任何数字的「下一步」提示。只读派生、不建第二套数值、不报分数、不改关系、不画界面。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "AGPL-3.0",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@types/node": "22.20.1"
  }
}
