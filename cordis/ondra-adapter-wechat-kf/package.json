{
  "name": "ondra-adapter-wechat-kf",
  "description": "空谷 Ondra 的微信客服通道：拉取式 sync_msg 每 5 秒一轮 + 游标去重（不需要公网回调）、单条 800 切条、48 小时会话窗口。可选回调只用于事件接收，挂上才需要 sha1 验签。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "AGPL-3.0",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@types/node": "22.20.1"
  }
}
