{
  "name": "ondra-adapter-qq-napcat",
  "description": "空谷 Ondra 的 QQ NapCat（OneBot v11）通道——高危：enable 与 confirmed 双闸门 + 独立确认档案、QQ 号与群号分开的白名单、六道防封闸、反向 WS 升级路由。编解码是端口不是实现：仓内没有 OneBot 帧依据就不写「看起来能跑」的握手。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "AGPL-3.0",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@types/node": "22.20.1"
  }
}
