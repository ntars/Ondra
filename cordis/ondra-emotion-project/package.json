{
  "name": "ondra-emotion-project",
  "description": "空谷 Ondra 的情感投影（手册 §2.6 / §4.3，P0 内感受铁律）：情绪的唯一文本出口。模板固定为「行为指令句 + 一条暗示」，禁止出现任何数字、维度名与情绪标签名，只给「有点提不起劲」这类主观表述。用户明确问数值时才允许转向 ui-api 的 /status；片段排序恒为正数（尾部），以守住前缀缓存。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "AGPL-3.0",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@types/node": "22.20.1"
  }
}
