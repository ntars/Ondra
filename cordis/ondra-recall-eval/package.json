{
  "name": "ondra-recall-eval",
  "description": "空谷 Ondra 的检索评估：20–40 条真实问法（含换说法与编造题），输出 recall@1/@3/@5 与 MRR，报告落盘并带参数快照。只测量不调参；不可判的题剔除而不是记 0 分。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "AGPL-3.0",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@types/node": "22.20.1"
  }
}
