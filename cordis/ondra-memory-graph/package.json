{
  "name": "ondra-memory-graph",
  "description": "空谷 Ondra 的记忆图谱：四边建边与 1 跳扩散。同主题 0.72 起每次 +0.05、共现 0.15 起每次 +0.10、荒诞 0.03 永不进检索；扩散门槛 0.4、枢纽度上限 40、90 天 ×0.5（带 decayed_at 游标）。只碰边表，绝不写 memory_fact。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "AGPL-3.0",
  "ondra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@ntars/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ntars/cordis": "workspace:~",
    "@types/node": "22.20.1"
  }
}
